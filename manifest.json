{
  "manifest_version": 3,
  "name": "AtmoSphere AI",
  "version": "1.1",
  "description": "Pro-grade weather dashboard with AI summaries and smart alerts.",
  "permissions": [
    "storage",
    "geolocation",
    "alarms",
    "action",
    "notifications" 
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}