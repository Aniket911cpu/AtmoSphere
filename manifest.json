{
    "manifest_version": 3,
    "name": "AtmoSphere AI",
    "version": "1.0",
    "description": "Intelligent weather dashboard with AI summaries and live badge updates.",
    "permissions": [
        "storage",
        "geolocation",
        "alarms",
        "action"
    ],
    "host_permissions": [
        "https://api.open-meteo.com/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": false
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}